{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('role').val() === newData.child('role').val())",
        "events": {
          "$eventId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".validate": "newData.hasChildren(['used','createdAt']) && newData.child('used').isBoolean() && newData.child('createdAt').isNumber()"
      },
      ".indexOn": [
        "createdBy"
      ]
    },
    "publicEvents": {
      "$eventId": {
        ".read": true,
        ".write": "auth != null && newData.child('ownerUid').val() === auth.uid && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['title','questions','minute','count','ownerUid']) && newData.child('title').isString() && newData.child('minute').isNumber() && newData.child('count').isNumber() && newData.child('ownerUid').isString()"
      }
    },
    "publicResults": {
      "$eventId": {
        ".read": "auth != null && root.child('publicEvents').child($eventId).child('ownerUid').val() === auth.uid",
        "$resultId": {
          ".write": true,
          ".validate": "newData.hasChildren(['name','score','total','time','timestamp','eventId']) && newData.child('name').isString() && newData.child('score').isNumber() && newData.child('total').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= newData.child('total').val() && newData.child('time').isNumber() && newData.child('timestamp').isNumber() && newData.child('eventId').val() === $eventId"
        }
      }
    },
    "attempts": {
      "$eventId": {
        "$kind": {
          "$key": {
            ".read": false,
            ".write": true,
            ".validate": "newData.hasChildren(['timestamp']) && newData.child('timestamp').isNumber()"
          }
        }
      }
    }
  }
}