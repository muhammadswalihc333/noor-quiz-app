{
  "rules": {
    ".read": false,
    ".write": false,
    "masterAdmin": {
      "organizers": {
        ".read": "auth != null && auth.token.email == 'muhammadswalihc333@gmail.com'",
        "$orgId": {
          ".read": "auth != null && (auth.token.email == 'muhammadswalihc333@gmail.com' || (data.exists() && data.child('email').val() == auth.token.email && data.child('active').val() == true))",
          ".write": "auth != null && auth.token.email == 'muhammadswalihc333@gmail.com'",
          ".validate": "newData.hasChildren(['name','email','activationCode','active','created']) && newData.child('email').isString() && newData.child('activationCode').isString()"
        }
      }
    },
    "organizerLookup": {
      "$emailHash": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'muhammadswalihc333@gmail.com'",
        ".validate": "newData.hasChildren(['orgId','active']) && newData.child('orgId').isString() && newData.child('active').isBoolean()"
      }
    },
    "events": {
      ".read": true,
      "$eventId": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'muhammadswalihc333@gmail.com' || !data.exists() || data.child('ownerId').val() == auth.uid || data.child('ownerId').val() == '')"
      }
    },
    "results": {
      ".read": "auth != null",
      "$eventId": {
        ".read": "auth != null",
        ".write": true
      }
    }
  }
}
